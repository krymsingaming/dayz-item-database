  "reliabilityStates": {
    "confirmed": {
      "display": "Confirmed information",
      "icon": "",
      "description": "Information has been confirmed through direct observation or sufficiently strong evidence."
    },
    "inferred": {
      "display": "Inferred information",
      "icon": "ⓘ",
      "description": "This information was inferred from related evidence such as trader listings, spreadsheet data, or other documented relationships. It may be useful but has not been directly confirmed."
    },
    "missing": {
      "display": "Information not found yet",
      "icon": "⚠",
      "description": "This information has not been found or documented yet. If you can supply it, please report it so the database can be improved."
    },
    "incorrect": {
      "display": "Reported incorrect",
      "icon": "⚠",
      "description": "This information has been reported as incorrect and needs correction or verification."
    },
    "underReview": {
      "display": "Under review",
      "icon": "ⓘ",
      "description": "This information is being reviewed or has conflicting evidence."
    },
    "knownBug": {
      "display": "Known bug / limitation",
      "icon": "⚠",
      "description": "The information reflects a known server or mod limitation, bug, or other actionable issue."
    },
    "notApplicable": {
      "display": "Confirmed unavailable / not applicable",
      "icon": "❌",
      "description": "This information does not exist or does not apply here. For trader prices, this means the trader does not perform that action."
    },
    "warning": {
      "display": "Reported incorrect",
      "icon": "⚠",
      "description": "This information has been reported as incorrect and needs correction or verification."
    },
    "informational": {
      "display": "Inferred information",
      "icon": "ⓘ",
      "description": "This information was inferred from related evidence such as trader listings, spreadsheet data, or other documented relationships. It may be useful but has not been directly confirmed."
    }
  },
  "sourcePriority": [
    {
      "id": "user_observation",
      "name": "Direct server observation",
