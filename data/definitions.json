    {
      "id": "player_report",
      "name": "Player report",
      "priority": 4
    }
  ],
  "propertyModel": {
    "category": "broad item class",
    "subcategory": "optional specific form/type",
    "properties": "single searchable/descriptive property collection; use booleans or values when appropriate",
    "rule": "Do not create separate tags, forms, or type fields when the same concept can be represented here."
  },
  "traderAvailabilityRules": {
    "sellOnly": "A listing with a sell price but no buy price means the trader is not a source of the item. The item must be obtained by some other route, such as world spawn and/or crafting. This does not by itself prove which route applies.",
    "buyAndSell": "A listing with both a buy and sell price means the trader is a source of the item and also accepts it for sale. This does not prove whether the item also spawns in the world.",
    "invalidBuyOnly": "A buy price without a sell price is not an expected trader state in the current server data. Treat it as a data inconsistency that needs review, not as an acquisition category.",
    "mixed": "If different trader listings for the same displayed item have different states, preserve each listing and show the combined state as mixed."
  },
  "traderStateLabels": {
    "sellOnly": {
      "label": "Sell Only",
      "description": "The trader accepts this item but does not sell it. Obtain the item elsewhere, such as through world spawn and/or crafting."
    },
    "buyAndSell": {
      "label": "Buy & Sell",
      "description": "The trader is a source of this item and also accepts it for sale. World-spawn status is not established by trader data alone."
    },
    "invalidBuyOnly": {
      "label": "Buy Without Sell",
      "description": "Unexpected trader state: a buy price exists without a sell price."
    }
  },
